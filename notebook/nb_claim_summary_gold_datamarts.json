						}
					}
				},
				"source": [
					"### 1.Import"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import functions as F\n",
					"from pyspark.sql.window import Window\n",
					"from delta.tables import DeltaTable"
				],
				"execution_count": 44
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 2.Configuration"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"storage_account=\"rakeshsynapseadlsgen2\"\n",
					"container_name=\"insurancedataplatform\"\n",
					"\n",
					"bronze_path=(f\"abfss://{container_name}@{storage_account}.dfs.core.windows.net/bronze/\")\n",
					"policy_silver_path=(f\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/policy/\")\n",
					"customer_silver_path=(f\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/customer/\")\n",
					"vehicle_silver_path=(f\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/vehicle/\")\n",
					"claim_silver_path=(f\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/silver/claim/\")\n",
					"gold_claim_summary_path=(f\"abfss://insurancedataplatform@rakeshsynapseadlsgen2.dfs.core.windows.net/gold/\")"
				],
				"execution_count": 54
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 3.Read Silver Tables"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"policy_df = spark.read.format(\"delta\").load(policy_silver_path)\n",
					"\n",
					"customer_df = spark.read.format(\"delta\").load(customer_silver_path)\n",
					"\n",
					"vehicle_df = spark.read.format(\"delta\").load(vehicle_silver_path)\n",
					"\n",
					"claim_df = spark.read.format(\"delta\").load(claim_silver_path)"
				],
				"execution_count": 47
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 4.Keep Only Current Dimension Records"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"policy_df = policy_df.filter(F.col(\"is_current\")==\"Y\")\n",
					"\n",
					"customer_df = customer_df.filter(F.col(\"is_current\")==\"Y\")\n",
					"\n",
					"vehicle_df = vehicle_df.filter(F.col(\"is_current\")==\"Y\")"
				],
				"execution_count": 48
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 5.Join Fact with Dimensions"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"gold_claim_summary_df = (\n",
					"    claim_df.alias(\"f\")\n",
					"\n",
					"    .join(\n",
					"        policy_df.alias(\"p\"),\n",
					"        on=\"policy_sk\",\n",
					"        how=\"left\"\n",
					"    )\n",
					"\n",
					"    .join(\n",
					"        customer_df.alias(\"c\"),\n",
					"        on=\"customer_sk\",\n",
					"        how=\"left\"\n",
					"    )\n",
					"\n",
					"    .join(\n",
					"        vehicle_df.alias(\"v\"),\n",
					"        on=\"vehicle_sk\",\n",
					"        how=\"left\"\n",
					"    )\n",
					")"
				],
				"execution_count": 49
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 6.Validate gold data mart claim summary"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"print(gold_claim_summary_df.count())\n",
					"\n",
					"gold_claim_summary_df.show(5, truncate=False)"
				],
				"execution_count": null
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 7.Select Business Columns"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"gold_claim_summary_df = (\n",
					"    gold_claim_summary_df.select(\n",
					"\n",
					"        # Keys\n",
					"        \"policy_sk\",\n",
					"        \"customer_sk\",\n",
					"        \"vehicle_sk\",\n",
					"        \"p.policy_number\",\n",
					"\n",
					"        # Policy\n",
					"        \"policy_bind_date\",\n",
					"        \"policy_state\",\n",
					"        \"policy_csl\",\n",
					"        \"policy_deductable\",\n",
					"        \"policy_annual_premium\",\n",
					"        \"umbrella_limit\",\n",
					"\n",
					"        # Customer\n",
					"        \"months_as_customer\",\n",
					"        \"age\",\n",
					"        \"insured_zip\",\n",
					"        \"insured_sex\",\n",
					"        \"insured_education_level\",\n",
					"        \"insured_occupation\",\n",
					"        \"insured_hobbies\",\n",
					"        \"insured_relationship\",\n",
					"\n",
					"        # Vehicle\n",
					"        \"auto_make\",\n",
					"        \"auto_model\",\n",
					"        \"auto_year\",\n",
					"\n",
					"        # Claim\n",
					"        \"incident_date\",\n",
					"        \"incident_type\",\n",
					"        \"collision_type\",\n",
					"        \"incident_severity\",\n",
					"        \"authorities_contacted\",\n",
					"        \"incident_state\",\n",
					"        \"incident_city\",\n",
					"        \"incident_location\",\n",
					"        \"incident_hour_of_the_day\",\n",
					"        \"number_of_vehicles_involved\",\n",
					"        \"property_damage\",\n",
					"        \"bodily_injuries\",\n",
					"        \"witnesses\",\n",
					"        \"police_report_available\",\n",
					"        \"total_claim_amount\",\n",
					"        \"injury_claim\",\n",
					"        \"property_claim\",\n",
					"        \"vehicle_claim\",\n",
					"        \"fraud_reported\"\n",
					"    )\n",
					")"
				],
				"execution_count": 52
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 8. Validate gold claim sumery data "
				]
			},
			{
				"cell_type": "code",
				"source": [
					"print(gold_claim_summary_df.count())\n",
					"\n",
					"gold_claim_summary_df.show(5, truncate=False)"
				],
				"execution_count": null
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"### 9.Write to gold layer"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"gold_claim_summary_df.write \\\n",
					"    .format(\"delta\") \\\n",
					"    .mode(\"overwrite\") \\\n",
					"    .save(gold_claim_summary_path)\n",
					"\n",
					"print(\"Gold Claim Summary Loaded Successfully\")"
				],
				"execution_count": 55
			}
		]
	}
