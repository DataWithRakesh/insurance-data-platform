						"source": [
							"target_df = spark.read.format(\"delta\").load(silver_path)\n",
							"\n",
							"# Get the last number of the Surrogate key which is \"policy_sk\"\n",
							"max_sk_df = target_df.agg(F.max(\"policy_sk\").alias(\"max_sk\"))\n",
							"\n",
							"max_sk= max_sk_df.collect()[0][\"max_sk\"]\n",
							"\n",
							"if max_sk is None:\n",
							"    max_sk = 0\n",
							"\n",
							"print(f\"Current max policy sk is : {max_sk}\")\n",
							"\n",
							"comparision_df =(\n",
							"                policy_df.alias(\"src\")\n",
							"                .join(\n",
							"                    target_df.filter(F.col(\"is_current\")==\"Y\").alias(\"tgt\"),\n",
							"                    on=\"policy_number\",\n",
							"                    how=\"left\"\n",
							"                )\n",
							")\n",
							"\n",
							"comparision_df=(\n",
							"                comparision_df.withColumn(\n",
							"                    \"merge_action\",F.when(\n",
							"                            F.col(\"tgt.policy_number\").isNull(),\n",
							"                            \"INSERT\"\n",
							"                    ).when(\n",
							"                        F.col(\"src.change_hash\")!=F.col(\"tgt.change_hash\"),\n",
							"                        \"UPDATE\"\n",
							"                    ).otherwise(\"NO_CHANGE\")\n",
							"                    \n",
							"                )\n",
							")\n",
							""
						],
						"outputs": [],
						"execution_count": 8
					},
